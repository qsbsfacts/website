---
import statesData from '../../data/states.json';
import { statusStyles } from '../statePresentation';

const counts = {
  conforms: statesData.filter(s => s.qsbsConformity === 'conforms').length,
  decoupled: statesData.filter(s => s.qsbsConformity === 'decoupled').length,
  pending: statesData.filter(s => s.qsbsConformity === 'pending').length,
  partial: statesData.filter(s => s.qsbsConformity === 'partial').length,
  none: statesData.filter(s => s.qsbsConformity === 'none').length,
};
const showPending = counts.pending > 0;
const boxCols = showPending ? 'md:grid-cols-5' : 'md:grid-cols-4';
---

<h3 class="text-xl font-semibold text-center mb-6">State QSBS Conformity</h3>
<p class="text-center text-sm text-gray-600 mb-5">Choose a state to see its tax rate and policy details. Statuses include enacted changes; check the notes for effective dates.</p>
<div class="flex flex-wrap justify-center gap-4 mb-6 text-sm">
  {Object.entries(statusStyles).filter(([key]) => key !== 'pending' || showPending).map(([key, status]) => <span class="flex items-center gap-2"><span class="size-5 rounded text-white text-center" style={{ background: status.color }} aria-hidden="true">{status.symbol}</span>{status.label}</span>)}
</div>
<label for="state-finder" class="block max-w-sm mx-auto text-sm font-medium mb-2">Find your state</label>
<select id="state-finder" class="block w-full max-w-sm mx-auto border border-gray-300 rounded-lg p-3 mb-6">
  <option value="">Select a state…</option>
  {statesData.map(state => <option value={state.code}>{state.name}</option>)}
</select>
<div id="state-grid" class="grid grid-cols-5 sm:grid-cols-7 md:grid-cols-9 lg:grid-cols-11 gap-1 max-w-4xl mx-auto mb-8">
  {statesData.map(state => (
    <button
      class="state-tile min-h-11 p-2 rounded-md text-xs font-bold text-center cursor-pointer text-white transition-transform hover:-translate-y-0.5"
      style={{ background: statusStyles[state.qsbsConformity as keyof typeof statusStyles].color }}
      aria-pressed="false"
      aria-controls="state-detail"
      data-code={state.code}
      data-name={state.name}
      data-rate={state.taxRate}
      data-conformity={state.qsbsConformity}
      data-note={state.note}
      aria-label={`${state.name}: ${state.qsbsConformity}`}
    >
      <span aria-hidden="true" class="block text-[10px] leading-none mb-1">{statusStyles[state.qsbsConformity as keyof typeof statusStyles].symbol}</span>{state.code}
    </button>
  ))}
</div>

<div id="state-detail" role="status" aria-live="polite" aria-atomic="true" class="bg-white rounded-xl shadow-lg p-6 max-w-lg mx-auto hidden mb-8">
  <h3 id="detail-name" class="text-xl font-bold mb-2"></h3>
  <div class="grid grid-cols-2 gap-4 text-sm mb-3">
    <div><span class="text-gray-500">Tax rate:</span> <strong id="detail-rate"></strong></div>
    <div><span class="text-gray-500">QSBS status:</span> <strong id="detail-status"></strong></div>
  </div>
  <p id="detail-note" class="text-sm text-gray-600"></p>
</div>

<div class={`grid grid-cols-2 ${boxCols} gap-4 max-w-3xl mx-auto text-center text-sm mb-16`}>
  <div class="bg-green-50 rounded-lg p-3">
    <p class="text-2xl font-bold text-green-700">{counts.conforms}</p>
    <p class="text-green-600">Conform</p>
  </div>
  <div class="bg-red-50 rounded-lg p-3">
    <p class="text-2xl font-bold text-red-700">{counts.decoupled}</p>
    <p class="text-red-600">Decoupled</p>
  </div>
  {showPending && (
    <div class="bg-amber-50 rounded-lg p-3">
      <p class="text-2xl font-bold text-amber-700">{counts.pending}</p>
      <p class="text-amber-600">Pending</p>
    </div>
  )}
  <div class="bg-blue-50 rounded-lg p-3">
    <p class="text-2xl font-bold text-blue-700">{counts.partial}</p>
    <p class="text-blue-600">Partial</p>
  </div>
  <div class="bg-gray-50 rounded-lg p-3">
    <p class="text-2xl font-bold text-gray-700">{counts.none}</p>
    <p class="text-gray-600">No income tax</p>
  </div>
</div>

<script>
  const finder = document.getElementById('state-finder') as HTMLSelectElement;
  const tiles = document.querySelectorAll<HTMLButtonElement>('.state-tile');
  function selectState(el: HTMLButtonElement) {
    tiles.forEach(tile => tile.setAttribute('aria-pressed', String(tile === el)));
    finder.value = el.dataset.code || '';
    document.getElementById('detail-name')!.textContent = el.dataset.name || '';
    document.getElementById('detail-rate')!.textContent = el.dataset.rate + '%';
    const status = el.dataset.conformity || '';
    document.getElementById('detail-status')!.textContent = status === 'none' ? 'No income tax' : status.charAt(0).toUpperCase() + status.slice(1);
    document.getElementById('detail-note')!.textContent = el.dataset.note || 'Standard federal conformity.';
    document.getElementById('state-detail')!.classList.remove('hidden');
  }
  tiles.forEach(tile => tile.addEventListener('click', () => selectState(tile)));
  finder.addEventListener('change', () => {
    const tile = Array.from(tiles).find(tile => tile.dataset.code === finder.value);
    if (tile) selectState(tile);
    else {
      tiles.forEach(tile => tile.setAttribute('aria-pressed', 'false'));
      document.getElementById('state-detail')!.classList.add('hidden');
    }
  });
</script>
