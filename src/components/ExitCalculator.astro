---
import statesData from '../../data/states.json';
import { calcTax, describeTax } from '../calcTax';

// Render a real default scenario for readers and crawlers before JS runs.
const initialGain = 2810;
const initialState = statesData[0];
const initialTax = calcTax(initialGain, initialState.taxRate, initialState.qsbsConformity, '2010-2025', initialState.code, { holdingYears: 5, saleYear: 2026 });
const currency = (amount: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(amount);

const comparisonStates = ['TX', 'FL', 'WA', 'CA', 'OR', 'NY'];
const comparisonData = comparisonStates.map(code => statesData.find(s => s.code === code)!);

interface Props {
  headingLevel?: 2 | 3;
  showIntro?: boolean;
}
const { showIntro = false } = Astro.props;
const Heading = Astro.props.headingLevel === 2 ? 'h2' : 'h3';
---

<div class="bg-white rounded-2xl shadow-lg p-6 md:p-10">
  {showIntro && (
    <p class="text-gray-500 text-center mb-8 max-w-2xl mx-auto text-sm">
      This comparison assumes the shares qualify for QSBS and satisfy the relevant holding period.
      Enter gain after subtracting tax basis, not the total sale proceeds or option-exercise compensation.
      <a href="/calculator/#methodology" class="underline">Read the model assumptions</a> before using an estimate.
    </p>
  )}

  <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
    <div>
      <label for="state-select" class="block text-sm font-medium text-gray-700 mb-2">Your state</label>
      <select id="state-select" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
        {statesData.map(state => (
          <option value={state.code} data-rate={state.taxRate} data-conformity={state.qsbsConformity} data-note={state.note}>
            {state.name}
          </option>
        ))}
      </select>
    </div>
    <div>
      <label for="exit-input" class="block text-sm font-medium text-gray-700 mb-2">Stock-sale gain</label>
      <input
        type="text"
        id="exit-input"
        value="$2,810"
        inputmode="numeric"
        class="w-full border border-gray-300 rounded-lg px-4 py-3 text-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
        aria-label="Stock-sale gain in dollars" aria-describedby="gain-help"
      />
      <p id="gain-help" class="text-xs text-gray-600 mt-1">Sale proceeds minus tax basis.</p>
    </div>
    <div>
      <label for="period-select" class="block text-sm font-medium text-gray-700 mb-2">Year stock was acquired</label>
      <select id="period-select" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
        <option value="before-2009">Aug 11, 1993 – Feb 17, 2009 (50%)</option>
        <option value="2009-2010">Feb 18, 2009 – Sep 27, 2010 (75%)</option>
        <option value="2010-2025" selected>Sep 28, 2010 – July 4, 2025 (100%)</option>
        <option value="after-july-2025">After July 4, 2025 (OBBBA)</option>
      </select>
    </div>
    <div>
      <label for="sale-year-select" class="block text-sm font-medium text-gray-700 mb-2">Tax year of sale</label>
      <select id="sale-year-select" class="w-full border border-gray-300 rounded-lg px-4 py-3 text-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
        <option value="2026" selected>2026</option>
        <option value="2027">2027 or later</option>
      </select>
      <p class="text-xs text-gray-600 mt-1">2027+ applies the modeled RI change; future inflation and other law changes are not projected.</p>
    </div>
  </div>

  <p class="text-sm text-gray-600 mb-5">Assumes unused dollar-limit capacity and all eligibility requirements met. Uses simplified rates; federal tax, local tax, and the 10× basis alternative are not calculated.</p>
  <div id="holding-wrap" class="mb-8 hidden">
    <label for="holding-select" class="block text-sm font-medium text-gray-700 mb-2">Holding period (post–July 4, 2025 stock)</label>
    <select id="holding-select" class="w-full md:w-80 border border-gray-300 rounded-lg px-4 py-3 text-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
      <option value="5" selected>5+ years — 100% exclusion, $15M cap</option>
      <option value="4">4 years — 75% exclusion, $15M cap</option>
      <option value="3">3 years — 50% exclusion, $15M cap</option>
    </select>
  </div>

  <p id="scenario-note" class="hidden text-sm text-amber-900 bg-amber-50 rounded-lg p-4 mb-5">Hypothetical holding-period comparison: stock newly acquired after July 4, 2025 cannot reach three years until 2028, four until 2029, or five until 2030. The tax-year selector applies modeled state rules; it does not validate acquisition and sale dates. Special carryover rules need separate review.</p>
  <div id="calc-result" class="bg-primary-50 rounded-xl p-6 mb-8 text-center">
    <p class="text-sm text-gray-500 mb-1">Modeled state tax on this gain in <span id="result-state" class="font-semibold">{initialState.name}</span></p>
    <p id="result-amount" class="text-4xl md:text-5xl font-bold text-primary-700">{currency(initialTax)}</p>
    <p id="result-note" class="text-sm text-gray-500 mt-2">{describeTax({ tax: initialTax, exitAmount: initialGain, conformity: initialState.qsbsConformity, period: '2010-2025', stateCode: initialState.code, note: initialState.note, holdingYears: 5, saleYear: 2026 })}</p>
  </div>

  <Heading class="font-semibold text-gray-700 mb-4">Compare key states on the same gain</Heading>
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="border-b border-gray-200">
          <th class="py-3 pr-4 text-sm font-medium text-gray-500">State</th>
          <th class="py-3 pr-4 text-sm font-medium text-gray-500">Model Rate</th>
          <th class="py-3 pr-4 text-sm font-medium text-gray-500">QSBS Status</th>
          <th class="py-3 text-sm font-medium text-gray-500 text-right">Modeled Tax</th>
        </tr>
      </thead>
      <tbody id="comparison-body">
        {comparisonData.map(state => (
          <tr class="border-b border-gray-100 comparison-row" data-code={state.code} data-rate={state.taxRate} data-conformity={state.qsbsConformity}>
            <td class="py-3 pr-4 font-medium">{state.name}</td>
            <td class="py-3 pr-4 text-gray-600">{state.taxRate}%</td>
            <td class="py-3 pr-4">
              <span class={`inline-block px-2 py-1 text-xs font-medium rounded-full ${
                state.qsbsConformity === 'conforms' ? 'bg-green-100 text-green-800' :
                state.qsbsConformity === 'decoupled' ? 'bg-red-100 text-red-800' :
                state.qsbsConformity === 'pending' ? 'bg-amber-100 text-amber-800' :
                state.qsbsConformity === 'partial' ? 'bg-blue-100 text-blue-800' :
                'bg-gray-100 text-gray-800'
              }`}>
                {state.qsbsConformity === 'none' ? 'No income tax' : state.qsbsConformity}
              </span>
            </td>
            <td class="py-3 text-right font-semibold comparison-tax">{currency(calcTax(initialGain, state.taxRate, state.qsbsConformity, '2010-2025', state.code, { holdingYears: 5, saleYear: 2026 }))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="mt-6 text-center">
    <button id="share-btn" class="text-sm text-primary-500 hover:text-primary-700 transition-colors">
      Copy shareable link
    </button>
    <span id="share-confirm" role="status" aria-live="polite" class="text-sm text-green-600 ml-2 hidden">Copied!</span>
  </div>
</div>

<script>
  import { calcTax, describeTax } from '../calcTax';
  import type { AcquisitionPeriod, HoldingYears } from '../calcTax';

  const stateSelect = document.getElementById('state-select') as HTMLSelectElement;
  const exitInput = document.getElementById('exit-input') as HTMLInputElement;
  const periodSelect = document.getElementById('period-select') as HTMLSelectElement;
  const saleYearSelect = document.getElementById('sale-year-select') as HTMLSelectElement;
  const holdingSelect = document.getElementById('holding-select') as HTMLSelectElement;
  const holdingWrap = document.getElementById('holding-wrap')!;
  const resultState = document.getElementById('result-state')!;
  const resultAmount = document.getElementById('result-amount')!;
  const resultNote = document.getElementById('result-note')!;

  function formatCurrency(n: number): string {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n);
  }

  function parseExitAmount(raw: string): number {
    const cleaned = raw.replace(/[^0-9.]/g, '');
    const num = parseFloat(cleaned);
    return isNaN(num) ? 0 : Math.round(num);
  }

  function syncHoldingVisibility() {
    const show = periodSelect.value === 'after-july-2025';
    holdingWrap.classList.toggle('hidden', !show);
    document.getElementById('scenario-note')!.classList.toggle('hidden', !show);
  }

  function updateCalculator() {
    syncHoldingVisibility();
    const exitAmount = parseExitAmount(exitInput.value);
    const period = periodSelect.value as AcquisitionPeriod;
    const holdingYears = Number(holdingSelect.value) as HoldingYears;
    const saleYear = Number(saleYearSelect.value);
    const options = { holdingYears, saleYear };

    const selected = stateSelect.options[stateSelect.selectedIndex];
    const rate = parseFloat(selected.dataset.rate || '0');
    const conformity = selected.dataset.conformity || '';
    const note = selected.dataset.note || '';
    const stateName = selected.textContent?.trim() || '';
    const stateCode = selected.value;

    const tax = calcTax(exitAmount, rate, conformity, period, stateCode, options);
    resultState.textContent = stateName;
    resultAmount.textContent = formatCurrency(tax);
    resultAmount.className = tax > 0
      ? 'text-4xl md:text-5xl font-bold text-red-600'
      : 'text-4xl md:text-5xl font-bold text-green-600';
    resultNote.textContent = describeTax({
      tax, exitAmount, conformity, period, stateCode, note, holdingYears, saleYear,
    });

    document.querySelectorAll('.comparison-row').forEach(row => {
      const el = row as HTMLElement;
      const rowRate = parseFloat(el.dataset.rate || '0');
      const rowConformity = el.dataset.conformity || '';
      const rowCode = el.dataset.code || '';
      const rowTax = calcTax(exitAmount, rowRate, rowConformity, period, rowCode, options);
      const taxCell = el.querySelector('.comparison-tax')!;
      taxCell.textContent = formatCurrency(rowTax);
      (taxCell as HTMLElement).className = `py-3 text-right font-semibold comparison-tax ${rowTax > 0 ? 'text-red-600' : 'text-green-600'}`;
    });

    const url = new URL(window.location.href);
    url.searchParams.set('state', selected.value);
    url.searchParams.set('exit', exitAmount.toString());
    url.searchParams.set('period', period);
    url.searchParams.set('year', String(saleYear));
    if (period === 'after-july-2025') {
      url.searchParams.set('holding', String(holdingYears));
    } else {
      url.searchParams.delete('holding');
    }
    window.history.replaceState({}, '', url.toString());
  }

  stateSelect.addEventListener('change', updateCalculator);
  periodSelect.addEventListener('change', updateCalculator);
  saleYearSelect.addEventListener('change', updateCalculator);
  holdingSelect.addEventListener('change', updateCalculator);
  exitInput.addEventListener('input', updateCalculator);
  exitInput.addEventListener('blur', () => {
    const amount = parseExitAmount(exitInput.value);
    if (amount > 0) exitInput.value = formatCurrency(amount);
  });
  exitInput.addEventListener('focus', () => {
    const amount = parseExitAmount(exitInput.value);
    if (amount > 0) exitInput.value = amount.toString();
  });

  const params = new URLSearchParams(window.location.search);
  // Keep legacy share URLs while rejecting values absent from each control.
  for (const [key, select] of [['state', stateSelect], ['period', periodSelect], ['year', saleYearSelect], ['holding', holdingSelect]] as const) {
    const value = params.get(key);
    if (value && Array.from(select.options).some(option => option.value === value)) select.value = value;
  }
  const sharedGain = Number(params.get('exit'));
  if (params.has('exit') && Number.isFinite(sharedGain) && sharedGain >= 0) exitInput.value = formatCurrency(sharedGain);
  updateCalculator();

  document.getElementById('share-btn')?.addEventListener('click', async () => {
    const confirm = document.getElementById('share-confirm')!;
    try {
      const sharedUrl = new URL('/calculator/', window.location.origin);
      const current = new URL(window.location.href);
      for (const key of ['state', 'exit', 'period', 'year', 'holding']) {
        const value = current.searchParams.get(key);
        if (value !== null) sharedUrl.searchParams.set(key, value);
      }
      await navigator.clipboard.writeText(sharedUrl.href);
      confirm.textContent = 'Copied!';
      document.dispatchEvent(new Event('qsbs:share-success'));
    } catch {
      confirm.textContent = 'Could not copy. You can copy the address from your browser.';
    }
    confirm.classList.remove('hidden');
    setTimeout(() => confirm.classList.add('hidden'), 4000);
  });
</script>
