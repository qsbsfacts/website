---
interface Props {
  homeHref?: string;
}
const { homeHref = '/#take-action' } = Astro.props;
---

<section class="bg-primary-50 border-t border-primary-100 px-4 py-10">
  <div class="max-w-4xl mx-auto text-center">
    <p class="text-xs font-semibold text-primary-700 uppercase tracking-widest mb-2">What you can do</p>
    <h2 class="text-xl font-bold text-gray-800 mb-3">Oregon pledged a 2027 QSBS bill. New York kept conformity after a public fight.</h2>
    <p class="text-sm text-gray-600 mb-5 max-w-2xl mx-auto">
      Most legislators voting on QSBS have not seen the Treasury data. Send it to them.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href="https://openstates.org/find_your_legislator/"
        target="_blank"
        rel="noopener"
        class="inline-block bg-primary-600 text-white font-medium px-5 py-2 rounded-lg hover:bg-primary-700 transition-colors text-sm"
      >
        Find your legislator
      </a>
      <a
        href={homeHref}
        class="inline-block bg-white text-primary-800 font-medium px-5 py-2 rounded-lg border border-primary-200 hover:bg-primary-100 transition-colors text-sm"
      >
        More ways to help
      </a>
    </div>
  </div>
</section>
