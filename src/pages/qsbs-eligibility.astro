import { checklistGroups } from '../data/qsbsChecklist';
const law = 'https://www.law.cornell.edu/uscode/text/26/1202';
const sources = [
  { label: '26 U.S.C. §1202: qualification and anti-abuse requirements', url: law },
  { label: 'IRS: Schedule D instructions, qualification tests', url: 'https://www.irs.gov/instructions/i1040sd' },
  { label: '26 CFR §1.1202-2: redemption rules and exceptions', url: 'https://www.law.cornell.edu/cfr/text/26/1.1202-2' },
