---
import Layout from '../layouts/Base.astro';
import ExitCalculator from '../components/ExitCalculator.astro';
import ObbbaBox from '../components/ObbbaBox.astro';

const title = "QSBS State Tax Calculator — Compare Startup Exit Taxes";
const description = "Estimate state tax on a QSBS exit under Section 1202. Compare all 50 states, explore holding periods, and share your calculator results.";
---

<Layout
  title={title}
  description={description}
  canonicalPath="/calculator/"
  jsonLd={[{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "QSBS Exit Tax Calculator",
    "url": "https://qsbsfacts.org/calculator/",
    "description": description,
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "dateModified": "2026-09-04"
  }]}
>

  <main id="main-content" tabindex="-1" class="pt-20">
    <section class="px-4 py-16 md:px-8 lg:py-24 bg-gray-50">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-3xl md:text-4xl font-bold text-center mb-4">QSBS State Tax Calculator</h1>
        <p class="text-gray-500 text-center mb-4 max-w-2xl mx-auto">
          See what your state actually takes from a qualified small business stock exit under Section 1202.
        </p>
        <ObbbaBox compact headingLevel={2} />
        <ExitCalculator showIntro headingLevel={2} />
        <aside aria-label="Understand your calculator assumptions" class="mt-8 rounded-xl border border-primary-100 bg-primary-50 p-6">
          <p class="font-semibold text-primary-900 mb-3">Before relying on an estimate</p>
          <p class="text-sm text-gray-600 mb-4">The calculator compares modeled state taxes. It does not establish QSBS eligibility, tax residency, or your actual exclusion limit.</p>
          <div class="flex flex-wrap gap-4 text-sm text-primary-700">
            <a href="/qsbs-eligibility/" class="underline underline-offset-4">Check the eligibility requirements</a>
            <a href="/qsbs-holding-period/" class="underline underline-offset-4">Understand holding periods</a>
            <a href="/qsbs-exclusion-limits/" class="underline underline-offset-4">Read about exclusion limits</a>
          </div>
        </aside>
      </div>
    </section>
  </main>
</Layout>
