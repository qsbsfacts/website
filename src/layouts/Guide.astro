---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  summary: string;
  canonicalPath: string;
  category: string;
  sources: { label: string; url: string }[];
  related: { label: string; href: string }[];
}
const { title, description, heading, summary, canonicalPath, category, sources, related } = Astro.props;
const url = new URL(canonicalPath, Astro.site!).href;
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url,
  inLanguage: 'en-US',
  citation: sources.map(source => source.url),
}, {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'QSBS Facts', item: new URL('/', Astro.site!).href },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site!).href },
    { '@type': 'ListItem', position: 3, name: heading, item: url },
  ],
}];
---
<Base title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd} showCta={false}>
  <main id="main-content" tabindex="-1" class="pt-16">
    <header class="bg-primary-950 text-white px-4 py-12 md:py-16">
      <div class="max-w-4xl mx-auto">
        <nav aria-label="Breadcrumb" class="text-sm text-primary-200 mb-8 flex flex-wrap gap-2">
          <a href="/" class="hover:text-white underline underline-offset-4">QSBS Facts</a>
          <span aria-hidden="true">/</span>
          <a href="/guides/" class="hover:text-white underline underline-offset-4">Guides</a>
        </nav>
        <p class="text-primary-300 text-xs font-semibold uppercase tracking-widest mb-4">{category}</p>
        <h1 class="text-3xl md:text-5xl font-extrabold leading-tight max-w-3xl">{heading}</h1>
        <p class="text-lg text-primary-100 mt-6 max-w-3xl leading-relaxed">{summary}</p>
        <p class="text-xs text-primary-200 mt-6">Updated September 2026 · Educational information, not advice for a specific transaction.</p>
      </div>
    </header>
    <article class="guide-content max-w-3xl mx-auto px-4 py-12 md:py-16">
      <slot />
      <section class="guide-sources" aria-labelledby="guide-sources">
        <h2 id="guide-sources">Sources and further reading</h2>
        <ul>
          {sources.map(source => <li><a href={source.url}>{source.label}</a></li>)}
        </ul>
      </section>
    </article>
    <aside class="bg-primary-50 border-t border-primary-100 px-4 py-12" aria-labelledby="related-guides">
      <div class="max-w-4xl mx-auto">
        <h2 id="related-guides" class="text-2xl font-bold mb-6">Keep exploring</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {related.map(link => (
            <a href={link.href} class="block bg-white border border-primary-100 rounded-xl p-5 font-semibold text-primary-800 hover:border-primary-400 hover:bg-primary-50 transition-colors">
              {link.label} <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
        <a href="/guides/" class="inline-block mt-6 text-primary-700 underline underline-offset-4">Browse all QSBS guides</a>
      </div>
    </aside>
  </main>
</Base>
