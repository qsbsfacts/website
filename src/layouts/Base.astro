---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Seo from '../components/Seo.astro';
import Navigation from '../components/Navigation.astro';
import CtaStrip from '../components/CtaStrip.astro';

interface Props {
  showCta?: boolean;
  title: string;
  description: string;
  canonicalPath?: string;
  ogTitle?: string;
  ogDescription?: string;
  jsonLd?: object[];
}

const {
  showCta = true,
  title,
  description,
  canonicalPath = '',
  ogTitle,
  ogDescription,
  jsonLd = [],
} = Astro.props;

---

<html lang="en">
  <head>
    <Analytics />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      jsonLd={jsonLd}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>

    <Navigation />

    <slot />

    {showCta && <CtaStrip />}

    <!-- Footer -->
    <footer class="bg-primary-950 text-primary-300 px-4 py-12">
      <div class="max-w-5xl mx-auto text-center">
        <p class="text-white font-bold text-lg mb-2">QSBS Facts</p>
        <p class="text-sm mb-4">Data-driven analysis of Section 1202 QSBS tax policy.</p>
        <div class="flex flex-wrap justify-center gap-4 text-xs text-primary-400 mb-4">
          <a href="/guides/" class="hover:text-white">Guides</a>
          <a href="/evidence/" class="hover:text-white">Evidence</a>
          <a href="/who-uses-it/" class="hover:text-white">Who Uses It</a>
          <a href="/the-94-percent-claim/" class="hover:text-white">The 94% Claim</a>
          <a href="/calculator/" class="hover:text-white">Calculator</a>
          <a href="/state-impact/" class="hover:text-white">State Impact</a>
          <a href="/sources/" class="hover:text-white">Sources</a>
        </div>
        <p class="text-xs text-primary-300">
          Sources include U.S. Treasury and IRS publications, tax law, state agencies, and academic research.
          This site presents factual analysis and is not tax advice.
        </p>
        <p class="text-xs text-primary-300 mt-2">Updated September 2026.</p>
      </div>
    </footer>


  </body>
</html>
